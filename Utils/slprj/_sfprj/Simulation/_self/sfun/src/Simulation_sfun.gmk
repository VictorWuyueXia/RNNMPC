#--------------------------- Tool Specifications -------------------------
#
# Modify the following macros to reflect the tools you wish to use for
# compiling and linking your code.
#
CC = "C:\Program Files\MATLAB\R2023b\bin\win64\mex.exe" -R2018a
LD = $(CC) -f "C:\Users\Victor\AppData\Roaming\MathWorks\MATLAB\R2023b\mex_C++_win64.xml"
 
MODEL     = Simulation
TARGET      = sfun
MODULE_SRCS   = c2_Simulation.cpp c4_Simulation.cpp half_type.cpp
MODEL_SRC  = Simulation_sfun.cpp
MODEL_REG = Simulation_sfun_registry.cpp
MAKEFILE    = Simulation_sfun.gmk
MATLAB_ROOT  = c:\program files\matlab\r2023b\toolbox\stateflow\stateflow\..\..\..
BUILDARGS   = 
#------------------------------ Include/Lib Path ------------------------------
 
USER_INCLUDES = -I"C:\Users\Victor\documents\Projects\RNNMPC\Utils\slprj\_sfprj\simulation\_self\sfun\src" -I"C:\Users\Victor\documents\Projects\RNNMPC\Utils" -I"C:\Users\Victor\documents\Projects\RNNMPC\simulink_models" 
AUX_INCLUDES = 
MLSLSF_INCLUDES  = \
    -I"C:\Program Files\MATLAB\R2023b\extern\include" \
    -I"C:\Program Files\MATLAB\R2023b\simulink\include" \
    -I"C:\Program Files\MATLAB\R2023b\simulink\include\sf_runtime" \
    -I"C:\Program Files\MATLAB\R2023b\stateflow\c\mex\include" \
    -I"C:\Program Files\MATLAB\R2023b\rtw\c\src" \
    -I"C:\Users\Victor\Documents\Projects\RNNMPC\Utils\slprj\_sfprj\Simulation\_self\sfun\src" 

THIRD_PARTY_INCLUDES = 

INCLUDE_PATH = $(USER_INCLUDES) $(AUX_INCLUDES) $(MLSLSF_INCLUDES) $(COMPILER_INCLUDES) $(THIRD_PARTY_INCLUDES)
 
#----------------- Compiler and Linker Options --------------------------------
 
# Optimization Options
 
CC_OPTS =  
CPP_REQ_DEFINES = -DMATLAB_MEX_FILE
 
# Uncomment this line to move warning level to W4
# cflags = $(cflags:W3=W4)
CFLAGS = $(CPP_REQ_DEFINES) $(INCLUDE_PATH) CFLAGS="$$CFLAGS $(CC_OPTS)"
 
LDFLAGS =  
 
AUXLDFLAGS = 
#----------------------------- Source Files -----------------------------------
 
THIRD_PARTY_SRCS =   
REQ_SRCS  = $(MODEL_SRC) $(MODEL_REG) $(MODULE_SRCS) $(THIRD_PARTY_SRCS) 

USER_OBJS =

AUX_ABS_OBJS =

REQ_OBJS = $(REQ_SRCS:.cpp=.obj)
REQ_OBJS2 = $(REQ_OBJS:.c=.obj)
OBJS = $(REQ_OBJS2) $(USER_OBJS) $(AUX_ABS_OBJS) $(THIRD_PARTY_OBJS)
OBJLIST_FILE = Simulation_sfun.mol
SFCLIB = 
AUX_LNK_OBJS = 
USER_LIBS = 
PARLIB = 
 
#--------------------------------- Rules --------------------------------------
 
MEX_FILE_NAME = $(MODEL)_$(TARGET).mexw64
 
 $(MEX_FILE_NAME): $(MAKEFILE) $(OBJS) $(SFCLIB) $(AUX_LNK_OBJS)
	@echo ### Linking ...
	$(LD) -silent LD="$$MINGWROOT\bin\g++" LDFLAGS="$$LDFLAGS $(LDFLAGS) $(AUXLDFLAGS)" -output $(MEX_FILE_NAME) @$(OBJLIST_FILE) $(USER_LIBS) $(SFCLIB) $(PARLIB) $(IPPLIB) $(THIRD_PARTY_LIBS) 
%.obj :    %.c
	$(CC) -c $(CFLAGS) $<

%.obj :    %.cpp
	$(CC) -c $(CFLAGS) $<

