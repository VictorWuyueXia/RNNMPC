#--------------------------- Tool Specifications -------------------------
#
# Modify the following macros to reflect the tools you wish to use for
# compiling and linking your code.
#
CC = "C:\MATLAB\R2023b\bin\win64\mex.exe" -R2018a
LD = $(CC)
 
MODEL     = Simulation
TARGET      = cgxe
MODULE_SRCS   = m_7FHURCaqdj8HBx85ZVuatH.c m_Ubuc0hQMhWDyT4IHVUnH3F.c m_dnzcGMWurWPtQDFTDYOwHC.c m_tSgvweChskFYUuuPTg6HwH.c m_klQ7XEZS1zy3wE2vktBM0F.c m_6IzuJrL7P1zo7Fq3Jxa1PB.c
MODEL_SRC  = Simulation_cgxe.c
MODEL_REG = Simulation_cgxe_registry.c
MAKEFILE    = Simulation_cgxe.gmk
MATLAB_ROOT  = c:\matlab\r2023b\toolbox\stateflow\stateflow\..\..\..
BUILDARGS   = 
#------------------------------ Include/Lib Path ------------------------------
 
USER_INCLUDES = -I"C:\Users\administrator\Projects\RNNMPC\simulink_models\slprj\_cgxe\simulation\src" -I"C:\Users\administrator\Projects\RNNMPC\simulink_models" -I"C:\Users\Administrator\Projects\RNNMPC\Simulink_Models\slprj\_cprj" 
AUX_INCLUDES = 
MLSLSF_INCLUDES  = \
    -I"C:\MATLAB\R2023b\extern\include" \
    -I"C:\MATLAB\R2023b\simulink\include" \
    -I"C:\MATLAB\R2023b\rtw\c\src" 

THIRD_PARTY_INCLUDES = -I"C:\Users\Administrator\Projects\RNNMPC\Simulink_Models\slprj\_cgxe\Simulation\src" -I"C:\Users\Administrator\Projects\RNNMPC\Simulink_Models" -I"C:\MATLAB\R2023b\extern\lib\win64\mingw64" 

INCLUDE_PATH = $(USER_INCLUDES) $(AUX_INCLUDES) $(MLSLSF_INCLUDES) $(COMPILER_INCLUDES) $(THIRD_PARTY_INCLUDES)
 
#----------------- Compiler and Linker Options --------------------------------
 
# Optimization Options
 
CC_OPTS =  -w   -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS
CPP_REQ_DEFINES = -DMATLAB_MEX_FILE
 
# Uncomment this line to move warning level to W4
# cflags = $(cflags:W3=W4)
CFLAGS = $(CPP_REQ_DEFINES) $(INCLUDE_PATH) CFLAGS="$$CFLAGS $(CC_OPTS)"
 
LDFLAGS =  
 
AUXLDFLAGS = 
#----------------------------- Source Files -----------------------------------
 
THIRD_PARTY_SRCS =   
REQ_SRCS  = $(MODEL_SRC) $(MODEL_REG) $(MODULE_SRCS) $(THIRD_PARTY_SRCS) 

USER_OBJS =

AUX_ABS_OBJS =

REQ_OBJS = $(REQ_SRCS:.cpp=.obj)
REQ_OBJS2 = $(REQ_OBJS:.c=.obj)
OBJS = $(REQ_OBJS2) $(USER_OBJS) $(AUX_ABS_OBJS) $(THIRD_PARTY_OBJS)
OBJLIST_FILE = Simulation_cgxe.mol
SFCLIB = 
AUX_LNK_OBJS = 
USER_LIBS = 
PARLIB = 
 
#--------------------------------- Rules --------------------------------------
 
MEX_FILE_NAME = $(MODEL)_$(TARGET).mexw64
 
 $(MEX_FILE_NAME): $(MAKEFILE) $(OBJS) $(SFCLIB) $(AUX_LNK_OBJS)
	@echo ### Linking ...
	$(LD) -silent LD="$$MINGWROOT\bin\g++" LDFLAGS="$$LDFLAGS $(LDFLAGS) $(AUXLDFLAGS)" -output $(MEX_FILE_NAME) @$(OBJLIST_FILE) $(USER_LIBS) $(SFCLIB) $(PARLIB) $(IPPLIB) $(THIRD_PARTY_LIBS) 
%.obj :    %.c
	$(CC) -c $(CFLAGS) $<

%.obj :    %.cpp
	$(CC) -c $(CFLAGS) $<

