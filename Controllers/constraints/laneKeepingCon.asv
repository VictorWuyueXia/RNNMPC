function laneKeepingIneq = laneKeepingCon(X, e, ...
    NumLanes, laneVector)
    
    % types: BoundaryType
    % 0 for no markings (i.e. some road edges)
    % 1 for solid lines
    % 2 for dashed lines
    % 5 for double solid lines

    laneKeepingIneq=[-1;-1];
    y=X(:,2);
    boundaryTypes=laneVector(6,:);
    
    % If detected a full lane (two boundareis)
    if NumLanes == 2 && ~isnan(boundaryTypes(2)) 
        % left boundary
        if boundaryTypes(1)==1 || boundaryTypes(1)==5 % Solid or double solid
            LB_l = laneVector(:,1);
            LB_l = coumputeBoundary(LB_l, X);

            boundaryTypes(1) = LB_l-y-e; % soft constraint of staying inside
        end

        % right boundary
        if boundaryTypes(2)==1 || boundaryTypes(2)==5 % Solid or double solid
            LB_r = laneVector(:,2);
            LB_r = coumputeBoundary(LB_r, X);

            boundaryTypes(2) = y-LB_r-e; % soft constraint of staying inside
        end
    end
end

