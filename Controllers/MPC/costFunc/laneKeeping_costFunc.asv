function cost = laneKeeping_costFunc(X, NumLanes, laneVector, weight)
    cost=0;
    weight=weight*eye(size(X,1));
    Y=X(:,2);

    LB_l=zeros(size(y));
    if laneVector(6,1)~=0% If a left boundary is detected
        LB_l = laneVector(:,1);
        LB_l = coumputeBoundary(LB_l, X);
    end

    LB_r=zeros(size(y));
    if laneVector(6,1)~=0 % If a right boundary is detected
        LB_r = laneVector(:,2);
        LB_r = coumputeBoundary(LB_r, X);
    end

    % Minimize the both the difference and sum 
    % of distances away from both lane boundareis
    distances_l =  Y- LB_l;
    distances_r =  Y- LB_r;

    distances = Y- LB;

    cost = distances' * weight * distances;

    ddis = distances_l - distances_r;
    sdis = distances_l + distances_r;
    distances = ddis + sdis;

    cost = distances' * weight * distances;
end
